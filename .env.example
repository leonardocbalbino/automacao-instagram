# Domínio público apontando para a VPS (o Caddy emite o certificado HTTPS)
DOMAIN=insta.seudominio.com.br
PUBLIC_URL=https://insta.seudominio.com.br

POSTGRES_PASSWORD=troque-esta-senha

# openssl rand -hex 32
JWT_SECRET=
# openssl rand -hex 32  (32 bytes; fica fora do banco)
TOKEN_ENCRYPTION_KEY=

# Só ADMIN_EMAIL pode criar o primeiro usuário (admin); depois o cadastro fecha
ADMIN_EMAIL=
ALLOW_SIGNUP=false

# Meta for Developers > seu app > Instagram > API setup with Instagram login
IG_APP_ID=
IG_APP_SECRET=
# Texto livre; o mesmo valor vai no campo "Verify token" do webhook no painel da Meta
IG_WEBHOOK_VERIFY_TOKEN=
GRAPH_VERSION=v23.0

# local: mídia servida pela própria API em PUBLIC_URL/media/...
# s3: S3 ou Cloudflare R2
STORAGE_DRIVER=local
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# Limites e anti-spam
PRIVATE_REPLIES_PER_HOUR=750
JITTER_MIN_MS=2000
JITTER_MAX_MS=8000

# Alertas (Slack/Discord incoming webhook, opcional)
ALERT_WEBHOOK_URL=

# Bull Board em /admin/queues (desligado se a senha estiver vazia)
BULL_BOARD_USER=admin
BULL_BOARD_PASSWORD=
